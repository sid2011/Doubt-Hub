{{> admin-shell-start}}

<h1 class="h4 mb-4">Content</h1>

<section id="doubts" class="mb-5">
  <h2 class="h5 mb-3">📝 Doubts</h2>
  <div class="card admin-card">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Student</th>
            <th>Title</th>
            <th>Subject</th>
            <th>Created</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#if doubts.length}}
            {{#each doubts}}
              <tr>
                <td>{{studentName}}</td>
                <td>{{title}}</td>
                <td>{{subject}}</td>
                <td>{{createdAtLabel}}</td>
                <td class="text-end">
                  <form class="d-inline js-confirm" data-message="Delete this content?" data-confirm="Delete" action="/admin/doubts/{{_id}}/delete" method="POST">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="5" class="text-secondary py-4">No doubts yet.</td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section id="answers">
  <h2 class="h5 mb-3">💬 Answers</h2>
  <div class="card admin-card">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Author</th>
            <th>Answer</th>
            <th>Review status</th>
            <th>Created</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#if answers.length}}
            {{#each answers}}
              <tr>
                <td>{{authorName}}</td>
                <td style="max-width: 320px;">{{preview}}</td>
                <td>{{reviewStatus}}</td>
                <td>{{createdAtLabel}}</td>
                <td class="text-end">
                  <form class="d-inline js-confirm" data-message="Delete this content?" data-confirm="Delete" action="/admin/answers/{{_id}}/delete" method="POST">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="5" class="text-secondary py-4">No answers yet.</td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</section>

{{> admin-shell-end}}
