<div class="container py-4" style="max-width: 720px;">
  <header class="d-flex justify-content-between align-items-center mb-4">
    <a href="/teacher" class="text-decoration-none fw-semibold text-dark">DoubtHub</a>
    <a href="/logout" class="text-decoration-none text-secondary">Log out</a>
  </header>

  <main>
    <h1 class="h3 mb-2">Hello, {{teacherName}}</h1>
    <p class="text-secondary mb-1">{{#if teacherSubject}}{{teacherSubject}}{{else}}No subject assigned{{/if}}</p>
    <p class="text-secondary mb-4" aria-live="polite">
      {{#if pendingCount}}
        {{pendingCount}} {{#if (eq pendingCount 1)}}answer needs{{else}}answers need{{/if}} review.
      {{else}}
        You're all caught up.
      {{/if}}
    </p>

    {{#if pendingCount}}
      <a href="/teacher/review" class="btn btn-primary btn-lg w-100 mb-4 py-3">
        Review Now
      </a>
    {{else}}
      <a href="/teacher/review" class="btn btn-outline-secondary btn-lg w-100 mb-4 py-3">
        Review Now
      </a>
    {{/if}}

    {{#if recentPending.length}}
      <h2 class="h6 text-secondary text-uppercase mb-3">Recent pending</h2>
      <ul class="list-unstyled mb-0">
        {{#each recentPending}}
          <li class="card mb-2">
            <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center gap-2 py-3">
              <div class="flex-grow-1">
                <div class="small text-secondary mb-1">{{doubt.subject}}</div>
                <div class="fw-semibold">{{doubt.title}}</div>
                <div class="small text-secondary">{{student.name}}</div>
              </div>
              <a href="/teacher/review/{{_id}}" class="btn btn-sm btn-primary">Review</a>
            </div>
          </li>
        {{/each}}
      </ul>
    {{/if}}
  </main>
</div>
