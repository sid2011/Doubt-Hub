<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#f8fafc;
    color:#1e293b;
    overflow-x:hidden;
}

/* HERO */

.hero{
    background:linear-gradient(135deg,#2563eb,#3b82f6);
    color:white;
    padding:80px 20px;
    text-align:center;
}

.hero-icon{
    font-size:60px;
    margin-bottom:15px;
}

.hero h1{
    font-size:3rem;
    font-weight:700;
    margin-bottom:10px;
}

.hero p{
    font-size:1.1rem;
    opacity:.95;
}

.last-updated{
    margin-top:15px;
    font-size:.95rem;
    opacity:.9;
}

.home-btn{
    margin-top:30px;
    border-radius:50px;
    padding:12px 28px;
    font-weight:600;
    transition:.3s;
}

.home-btn:hover{
    transform:translateY(-3px);
}

/* CONTENT */

.main-content{
    margin-top:-45px;
    margin-bottom:60px;
}

.terms-card{
    background:white;
    border-radius:18px;
    padding:30px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

/* SECTION */

.section{
    margin-bottom:28px;
    padding:25px;
    border-left:5px solid #2563eb;
    border-radius:12px;
    background:#ffffff;
    transition:.3s;
}

.section:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 25px rgba(0,0,0,.08);
}

.section h2{
    font-size:1.35rem;
    color:#2563eb;
    margin-bottom:15px;
    font-weight:600;
}

.section p{
    color:#475569;
    line-height:1.8;
}

.section ul{
    margin-top:12px;
    padding-left:20px;
}

.section li{
    margin-bottom:10px;
    color:#475569;
    line-height:1.7;
}

/* CONTACT */

.contact-card{
    background:#eff6ff;
    border:1px solid #bfdbfe;
    border-radius:15px;
    padding:25px;
    margin-top:20px;
}

.team-member{
    background:white;
    border-radius:12px;
    padding:20px;
    height:100%;
    border:1px solid #e2e8f0;
    transition:.3s;
}

.team-member:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 20px rgba(0,0,0,.08);
}

.team-member h4{
    color:#2563eb;
    margin-bottom:8px;
    font-weight:600;
}

.team-member p{
    margin-bottom:6px;
    color:#475569;
}

.team-member a{
    color:#2563eb;
    text-decoration:none;
}

.team-member a:hover{
    text-decoration:underline;
}

/* FOOTER */

.footer{
    background:#0f172a;
    color:#cbd5e1;
    text-align:center;
    padding:40px 20px;
}

.footer h5{
    color:white;
    margin-bottom:10px;
}

.footer p{
    margin-bottom:5px;
}

/* RESPONSIVE */

@media(max-width:992px){

.hero{
    padding:70px 20px;
}

.hero h1{
    font-size:2.4rem;
}

}

@media(max-width:768px){

.hero{
    padding:60px 15px;
}

.hero-icon{
    font-size:48px;
}

.hero h1{
    font-size:2rem;
}

.hero p{
    font-size:15px;
}

.main-content{
    margin-top:-30px;
}

.terms-card{
    padding:20px;
}

.section{
    padding:18px;
}

.section h2{
    font-size:1.2rem;
}

.section p,
.section li{
    font-size:15px;
}

.home-btn{
    width:100%;
    max-width:260px;
}

.contact-card{
    padding:18px;
}

.team-member{
    margin-bottom:20px;
}

.footer{
    padding:30px 15px;
}

}

@media(max-width:576px){

.hero{
    padding:50px 15px;
}

.hero h1{
    font-size:1.8rem;
}

.hero-icon{
    font-size:42px;
}

.terms-card{
    padding:15px;
}

.section{
    padding:15px;
}

.section h2{
    font-size:1.1rem;
}

}


</style>

</head>
