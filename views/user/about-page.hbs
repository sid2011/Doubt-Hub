<style>
    /* Reset & Base Variables */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --primary: #7c3aed;
      --primary-dark: #6d28d9;
      --primary-light: #ede9fe;
      --primary-subtle: #f5f3ff;
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-light: #64748b;
      --bg-white: #ffffff;
      --bg-subtle: #f8fafc;
      --border-color: #e2e8f0;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 28px;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 14px -2px rgba(124, 58, 237, 0.08), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
      --shadow-lg: 0 16px 32px -4px rgba(124, 58, 237, 0.12), 0 4px 12px -2px rgba(0, 0, 0, 0.05);
      --max-width: 1120px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: var(--text-main);
      background-color: var(--bg-white);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* Layout Container */
    .container {
      width: 100%;
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Header & Navigation */
    header {
      border-bottom: 1px solid var(--border-color);
      background-color: rgba(255, 255, 255, 0.95);
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(8px);
    }

    .nav-wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-main);
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }

    .brand-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #ffffff;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.15rem;
      box-shadow: 0 2px 6px rgba(124, 58, 237, 0.3);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--primary);
    }

    .nav-cta {
      display: inline-block;
      padding: 8px 18px;
      background-color: var(--primary-subtle);
      color: var(--primary);
      border: 1px solid var(--primary-light);
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .nav-cta:hover {
      background-color: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background-color: var(--primary-subtle);
      color: var(--primary);
      border: 1px solid var(--primary-light);
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .badge-dot {
      width: 8px;
      height: 8px;
      background-color: var(--primary);
      border-radius: 50%;
    }

    /* Section General */
    section {
      padding: 88px 0;
    }

    .section-title {
      font-size: clamp(1.85rem, 3.5vw, 2.4rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin-bottom: 16px;
      line-height: 1.25;
    }

    .section-desc {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.7;
    }

    /* 1. Hero Section */
    .hero-section {
      padding: 80px 0 96px;
      background: radial-gradient(circle at 50% 0%, var(--primary-subtle) 0%, rgba(255, 255, 255, 0) 70%);
      text-align: center;
    }

    .hero-content {
      max-width: 760px;
      margin: 0 auto;
    }

    .hero-title {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin-top: 20px;
      margin-bottom: 16px;
    }

    .hero-tagline {
      font-size: clamp(1.2rem, 2.5vw, 1.5rem);
      font-weight: 600;
      color: var(--primary);
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }

    .hero-intro {
      font-size: 1.125rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 44px;
    }

    /* Subtle Visual Element in Hero */
    .hero-visual {
      max-width: 600px;
      margin: 0 auto;
      background: var(--bg-white);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-xl);
      padding: 24px;
      box-shadow: var(--shadow-lg);
      text-align: left;
    }

    .hero-visual-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 14px;
      margin-bottom: 16px;
    }

    .mock-tag {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--primary);
      background: var(--primary-subtle);
      padding: 4px 10px;
      border-radius: 4px;
    }

    .mock-status {
      font-size: 0.8rem;
      color: #059669;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .mock-status::before {
      content: "";
      display: inline-block;
      width: 7px;
      height: 7px;
      background-color: #059669;
      border-radius: 50%;
    }

    .mock-question {
      font-weight: 600;
      font-size: 1rem;
      color: var(--text-main);
      margin-bottom: 14px;
    }

    .mock-answer-box {
      background: var(--bg-subtle);
      border-left: 3px solid var(--primary);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      padding: 12px 16px;
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* 2. Why DoubtHub Exists */
    .why-section {
      background-color: var(--bg-subtle);
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
      text-align: center;
    }

    .why-content {
      max-width: 740px;
      margin: 0 auto;
    }

    /* 3. Three Core Pillars */
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      margin-top: 48px;
    }

    .pillar-card {
      background: var(--bg-white);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 36px 28px;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      display: flex;
      flex-direction: column;
    }

    .pillar-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--primary-light);
    }

    .pillar-icon {
      font-size: 2.25rem;
      line-height: 1;
      margin-bottom: 20px;
    }

    .pillar-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }

    .pillar-text {
      font-size: 0.975rem;
      color: var(--text-muted);
      line-height: 1.65;
    }

    /* 4. Learn • Help • Grow (XP System) */
    .xp-section {
      background-color: var(--bg-subtle);
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
    }

    .xp-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 48px;
    }

    .xp-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .xp-card {
      background: var(--bg-white);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 24px 20px;
      text-align: center;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .xp-card:hover {
      border-color: var(--primary);
      box-shadow: var(--shadow-md);
    }

    .xp-badge {
      display: inline-block;
      background: var(--primary-subtle);
      color: var(--primary);
      font-weight: 700;
      font-size: 0.85rem;
      padding: 4px 10px;
      border-radius: 9999px;
      margin-bottom: 14px;
      border: 1px solid var(--primary-light);
    }

    .xp-card-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .xp-card-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* 5. How DoubtHub Works */
    .how-section {
      text-align: center;
    }

    .how-header {
      max-width: 640px;
      margin: 0 auto 52px;
    }

    .steps-wrapper {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }

    .step-card {
      background: var(--bg-white);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 36px 24px;
      text-align: left;
      box-shadow: var(--shadow-sm);
    }

    .step-number {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--primary-light);
      line-height: 1;
      margin-bottom: 16px;
      letter-spacing: -0.03em;
    }

    .step-name {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 12px;
    }

    .step-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* 6. Our Vision */
    .vision-section {
      background: linear-gradient(145deg, #2e1065 0%, #1e1b4b 100%);
      color: #ffffff;
      padding: 104px 0;
      text-align: center;
    }

    .vision-wrapper {
      max-width: 820px;
      margin: 0 auto;
    }

    .vision-tag {
      color: #c4b5fd;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 18px;
      display: inline-block;
    }

    .vision-quote {
      font-size: clamp(1.85rem, 3.5vw, 2.6rem);
      font-weight: 800;
      line-height: 1.3;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin-bottom: 28px;
    }

    .vision-subtext {
      font-size: 1.15rem;
      color: #ddd6fe;
      line-height: 1.8;
      max-width: 700px;
      margin: 0 auto;
    }

    /* 7. Closing CTA */
    .cta-section {
      text-align: center;
      padding: 96px 0;
      background: radial-gradient(circle at 50% 100%, var(--primary-subtle) 0%, rgba(255, 255, 255, 0) 70%);
    }

    .cta-wrapper {
      max-width: 640px;
      margin: 0 auto;
    }

    .cta-title {
      font-size: clamp(2rem, 4vw, 2.85rem);
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    .cta-subtitle {
      font-size: 1.15rem;
      color: var(--text-muted);
      margin-bottom: 36px;
      line-height: 1.6;
    }

    .btn-primary {
      display: inline-block;
      background-color: var(--primary);
      color: #ffffff;
      padding: 14px 34px;
      border-radius: var(--radius-sm);
      font-size: 1.05rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
      transition: all 0.2s ease;
    }

    .btn-primary:hover {
      background-color: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(124, 58, 237, 0.45);
    }

    /* Footer */
    footer {
      border-top: 1px solid var(--border-color);
      background-color: var(--bg-white);
      padding: 44px 0 36px;
      font-size: 0.9rem;
      color: var(--text-light);
    }

    .footer-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      text-align: center;
    }

    .footer-tagline {
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Responsive Styles */
    @media (max-width: 900px) {
      .pillars-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .xp-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .steps-wrapper {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    }

    @media (max-width: 640px) {
      section {
        padding: 64px 0;
      }
      .hero-section {
        padding: 56px 0 72px;
      }
      .pillars-grid {
        grid-template-columns: 1fr;
      }
      .xp-grid {
        grid-template-columns: 1fr;
      }
      .nav-links {
        display: none;
      }
    }
  </style>
  <header>
