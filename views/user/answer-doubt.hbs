<div class="container py-4">

  {{!-- ========== BACK LINK ========== --}}
  <div class="mb-3">
    <a href="/doubts" class="text-decoration-none muted-sm">
      <i class="bi bi-arrow-left me-1"></i> Back to all doubts
    </a>
  </div>

  {{!-- ========== QUESTION CARD ========== --}}
  <div class="card doubt-card mb-3">
    <div class="card-body p-4">
      <div class="d-flex align-items-center mb-3">
        <img src="{{doubt.student.avatar}}" onerror="this.src='https://api.dicebear.com/10.x/fun-emoji/svg?seed={{doubt.student.name}}'" class="avatar me-3" alt="student avatar">
        <div class="flex-grow-1">
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h6 class="mb-0 fw-semibold"></h6>
            <span class="muted-sm">• Class </span>
          </div>
          <div class="d-flex align-items-center gap-2 mt-1">
            <span class="subject-badge"><i class="bi bi-book me-1"></i>{{doubt.subject}}</span>
            <span class="muted-sm"><i class="bi bi-clock me-1"></i>{{doubt.createdAt}}</span>
          </div>
        </div>
      </div>

      <h4 class="doubt-title mb-2">{{doubt.title}}</h4>
      <p class="text-secondary mb-3" style="line-height:1.6;">{{doubt.description}}</p>

      <div class="d-flex flex-wrap gap-3 mb-2">
        <span class="stat-pill"><i class="bi bi-chat-dots-fill text-success"></i> {{answers.length}} Answers</span>
      </div>
      <hr class="mt-3 mb-0">
    </div>
  </div>

  {{!-- ========== ANSWER FORM ========== --}}
  <div class="card doubt-card mb-4">
    <div class="card-body p-4">
      <h6 class="fw-semibold mb-3"><i class="bi bi-pencil-square me-2 text-primary"></i>Write Your Answer</h6>
      <form action="/answer-doubt" method="POST" id="answerForm">
        <input type="hidden" name="doubtId" value="{{this.doubtId}}">
        <textarea
          id="answerText" name="answer"
          class="form-control answer-textarea mb-2"
          placeholder="Explain your answer clearly so the student can understand."
          maxlength="1000"></textarea>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <small class="muted-sm"><span id="charCount">0</span>/1000 characters</small>
          <button type="submit" class="btn btn-primary-soft btn-rounded btn-post-answer">
            <i class="bi bi-send-fill me-1"></i> Post Answer
          </button>
        </div>
      </form>
    </div>
  </div>

{{!-- ========== ANSWERS LIST ========== --}}
<div class="d-flex align-items-center justify-content-between mb-3">
  <h6 class="fw-semibold mb-0">Answers ({{answers.length}})</h6>
</div>

{{#if answers.length}}

  {{#each answers}}

    <div class="card answer-card mb-3">
      <div class="card-body p-3">

        {{#if (eq this.role "ai")}}

          {{!-- AI ANSWER --}}
          <div class="d-flex align-items-center mb-3">
            <div class="avatar me-3 d-flex align-items-center justify-content-center">
              🤖
            </div>

            <div>
              <h6 class="mb-0 fw-semibold">DoubtHub AI</h6>
              <span class="muted-sm">
                <i class="bi bi-stars me-1"></i>AI Answer
              </span>
            </div>
          </div>

          <div class="text-secondary mb-3 ps-1 ai-answer">
            {{{this.answer}}}
          </div>

        {{else}}

          {{!-- STUDENT / TEACHER ANSWER --}}
          <div class="d-flex align-items-center mb-2">

            <img
              src="https://api.dicebear.com/10.x/fun-emoji/svg?seed={{this.student.name}}"
              class="avatar me-3"
              alt="answerer"
            >

            <div class="flex-grow-1">

              <div class="d-flex flex-wrap align-items-center gap-2">
                <h6 class="mb-0 fw-semibold">
                  {{this.student.name}}
                </h6>

                <span class="muted-sm">
                  • Class {{this.student.class}}
                </span>

                {{#if this.xp}}
                  <span class="xp-badge">
                    <i class="bi bi-star-fill me-1"></i>
                    {{this.xp}} XP
                  </span>
                {{/if}}
              </div>

              <span class="muted-sm">
                <i class="bi bi-clock me-1"></i>
                {{this.postedAt}}
              </span>

            </div>
          </div>

          <p class="text-secondary mb-3 ps-1" style="line-height:1.6;">
            {{this.answer}}
          </p>

        {{/if}}

      </div>
    </div>

  {{/each}}

{{else}}

  <div class="card answer-card">
    <div class="card-body empty-state">
      <span class="emoji">💬</span>
      <h6 class="fw-semibold mb-1">No answers yet.</h6>
      <p class="mb-0">Be the first to help this student.</p>
    </div>
  </div>

{{/if}}
<script>
  const answerTextArea = document.getElementById('answerText');
  const charCount = document.getElementById('charCount');
  if (answerTextArea && charCount) {
    answerTextArea.addEventListener('input', function () {
      charCount.textContent = this.value.length;
    });
  }
</script>