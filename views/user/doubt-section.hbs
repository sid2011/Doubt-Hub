<div class="profile-wrapper">

    <button class="prof-btn" id="profBtn" type="button">

        <div class="ava ava-28">
            <img
                src="https://api.dicebear.com/10.x/fun-emoji/svg?seed={{userInfo.name}}"
                alt="{{userInfo.name}}"
            >
        </div>

        <span class="d-none d-md-inline">
            {{userInfo.name}}
        </span>

        <i class="bi bi-chevron-down chevron"></i>

    </button>


    <div class="prof-dd" id="profDd">

        <div class="prof-mini">

            <div class="ava ava-44">
                <img
                    src="https://api.dicebear.com/10.x/fun-emoji/svg?seed={{userInfo.name}}"
                    alt="{{userInfo.name}}"
                >
            </div>

            <div class="prof-mini-info">
                <strong>{{userInfo.name}}</strong>
                <div class="prof-mini-stats">
                    <span>⭐ {{userXP}} XP</span>
                    <span>·</span>
                    <span>Rank #{{rank}}</span>
                </div>
            </div>

        </div>

        <div class="dd-sep"></div>

        <a class="dd-item danger" href="/logout">
            <i class="bi bi-box-arrow-right"></i>
            Logout
        </a>

    </div>

</div>
  <!-- Mobile search bar -->
  <div class="mob-search-bar" id="mobSearchBar">
    <div style="position:relative">
      <i class="bi bi-search si" style="position:absolute;left:.8rem;top:50%;transform:translateY(-50%);color:var(--t3);font-size:.85rem;pointer-events:none"></i>
      <input type="text" class="finput" style="border-radius:var(--r-pill);padding:.45rem 1rem .45rem 2.2rem;font-size:.83rem" placeholder="Search doubts…"/>
    </div>
  </div>
</nav>

<!-- ══════════════════════════════════════════
     PAGE BODY
══════════════════════════════════════════ -->
<div class="page-wrap">
  <div class="layout">

    <!-- ════ FEED ════ -->
    <div class="feed">

      <!-- Welcome Banner -->
      <div class="welcome-banner">
        <div class="wb-ava">
        <img src="https://api.dicebear.com/10.x/fun-emoji/svg?seed={{userName}}" alt="{{userName}}"/>
        </div>
        <div class="wb-text">
          <h2>Good Day, {{userName}}! 👋</h2>
          <p>Help others and earn XP!</p>
        </div>
        <div class="wb-stats">
          <div class="wb-stat"><span class="num">{{userXP}}</span><span class="lbl">Total XP</span></div>
          <div class="wb-stat"><span class="num">#{{rank}}</span><span class="lbl">Rank</span></div>
        </div>
      </div>

      <!-- Filters -->
      <div class="filters-wrap">
        <div class="filter-row">
          <a href="#" class="fpill active"><i class="bi bi-lightning-charge-fill"></i> Latest</a>
          <a href="#" class="fpill"><i class="bi bi-fire"></i> Hot</a>
          <a href="#" class="fpill"><i class="bi bi-clock-history"></i> Unanswered</a>
          <a href="#" class="fpill"><i class="bi bi-check-circle-fill"></i> Solved</a>
          <a href="#" class="fpill"><i class="bi bi-bookmark-fill"></i> Saved</a>
        </div>
        <div class="subj-row">
          <a href="/doubts" class="spill active">All</a>
          <a href="/doubts?subject=Mathematics" class="spill s-math">📐 Maths</a>
          <a href="/doubts?subject=Physics" class="spill s-phy">⚛️ Physics</a>
          <a href="/doubts?subject=Chemistry" class="spill s-chem">🧪 Chemistry</a>
          <a href="/doubts?subject=Biology" class="spill s-bio">🌿 Biology</a>
          <a href="/doubts?subject=Computer Science" class="spill s-cs">💻 CS</a>
          <a href="/doubts?subject=English" class="spill s-eng">📖 English</a>
          <a href="/doubts?subject=Social Science" class="spill s-ss">🏛️ Social</a>
          <a href="/doubts?subject=Malayalam" class="spill s-mal">🌺 Malayalam</a>
        </div>
      </div>

      <!-- Feed header -->
      <div class="feed-header-row">
        <div>
          <div class="feed-title">Community Doubts</div>
        </div>
        <button class="ask-btn" data-bs-toggle="modal"
    data-bs-target="#askDoubtModal"">
          <i class="bi bi-plus-lg"></i> Ask Doubt
        </button>
      </div>
      

      <!-- ════ DOUBT CARDS ════ -->
      <!-- Card 1: Maths, Solved, Teacher Verified -->
      {{#each response}}
      <div class="dcard s-math" id="card-1">
        <div class="dcard-inner">
          <div class="dc-head">
            <div class="ava ava-38">
              <img src="https://api.dicebear.com/10.x/fun-emoji/svg?seed={{student.name}}" alt="{{student.name}}"/>
            </div>
            
            <div class="dc-user">
              <div class="dc-uname">{{student.name}}</div>
              <div class="dc-sub-row">
                <span class="xp-sm">⭐ {{student.xp}} XP</span>
                <span class="dot-sep">●</span>
                <span class="class-tag">Class {{student.class}} · STATE</span>
              </div>
              
            </div>
            <div class="dc-right">
              <span class="dc-time">{{timeAgo}}</span>
            </div>
          </div>
          <div class="dc-body">
            <a href="/answer-doubt/{{this._id}}" class="dc-title" onclick="openModal('answersModal');return false">{{this.title}}</a>
            <p class="dc-desc">{{this.description}}</p>
          </div>
          
        </div>
        <div class="dc-foot">
          <button class="like-btn" data-doubt-id="{{_id}}">
          {{#if isLiked}}
          <i class="bi bi-heart-fill"></i>
          {{else}}
          <i class="bi bi-heart"></i>
          {{/if}}
         <span class="like-count">{{likes.length}}</span>
         </button>
          <a href="/answer-doubt/{{this._id}}" class="fbt answers-fbt" role="button"><i class="bi bi-chat-dots-fill"></i><span class="answers-fbt">Answers</span></a>
          <button class="fbt" title="Report"><i class="bi bi-flag"></i></button>
        </div>
      </div>
{{/each}}

    </div>
    <!-- ════ SIDEBAR ════ -->
    <aside class="sidebar">

      <!-- Leaderboard -->
      
      <div class="sw">
        <div class="sw-head">
          <i class="bi bi-trophy-fill" style="color:var(--amber);margin-right:.45rem"></i>
          Top Contributors
        </div>
        <div class="lb-list">
        {{#each topLeaderboard}}
          <div class="lb-item lb-1">
            <div class="lb-pos">{{#if (eq @index 0)}}
  🥇
{{else if (eq @index 1)}}
  🥈
{{else if (eq @index 2)}}
  🥉
{{else}}
  {{inc @index}}
{{/if}}</div>
            <div class="ava ava-34"><img src="https://api.dicebear.com/10.x/fun-emoji/svg?seed={{name}}" alt="{{name}}"/></div>
            <div class="lb-info"><div class="lb-name">{{name}}</div><div class="lb-xp">⭐ {{xp}} XP </div></div>
            <div class="lb-badge-wrap"><div class="lb-bdg bdg-gold">🏆</div><div class="lb-bdg bdg-fire">🔥</div></div>
          </div>
          {{/each}}
          {{#if (gt rank 10)}}
   {{#if (gt rank 10)}}
  <div class="lb-item lb-n" style="background:linear-gradient(90deg,#f5f3ff,#fff);border-top:1px solid #ede9fe">
    <div class="lb-pos" style="font-size:.7rem;font-weight:800;color:var(--p)">
      {{rank}}
    </div>

    <div class="ava ava-34">
      <img src="https://api.dicebear.com/10.x/fun-emoji/svg?seed={{userName}}" alt="{{userName}}"/>
    </div>

    <div class="lb-info">
      <div class="lb-name" style="color:var(--p)">
        {{userName}}
        <span style="font-size:.65rem;font-weight:500;color:var(--t3)">(you)</span>
      </div>

      <div class="lb-xp">⭐ {{userXP}} XP</div>
    </div>
  </div>
{{/if}}
{{/if}}
        </div>
      </div>

      <!-- Earn XP -->
      <div class="sw">
        <div class="sw-head">
          <i class="bi bi-star-fill" style="color:var(--amber);margin-right:.45rem"></i>
          Earn XP
        </div>
        <div class="xp-rules">
          <div class="xp-row"><span class="xp-act">Ask a doubt</span><span class="xp-pts xp-pos">+5 XP</span></div>
          <div class="xp-row"><span class="xp-act">Answer a doubt</span><span class="xp-pts xp-pos">+10 XP</span></div>
          <div class="xp-row"><span class="xp-act">Answer accepted</span><span class="xp-pts xp-pos">+25 XP</span></div>
          <div class="xp-row"><span class="xp-act">Upvote received</span><span class="xp-pts xp-pos">+2 XP</span></div>
          <div class="xp-row"><span class="xp-act">Daily login</span><span class="xp-pts xp-pos">+3 XP</span></div>
          <div class="xp-row"><span class="xp-act">Downvote received</span><span class="xp-pts xp-neg">−1 XP</span></div>
        </div>
      </div>

    </aside>
  </div>
</div>

<!-- ════ FAB ════ -->
<button class="fab" id="fab" onclick="openModal('askModal')" aria-label="Ask a doubt">
  <i class="bi bi-plus-lg"></i>
</button>

<!-- ══════════════════════════════════════════
     ASK DOUBT MODAL
══════════════════════════════════════════ -->
<div class="modal-overlay" id="askModal" onclick="closeOnOverlay(event,'askModal')">
  <div class="modal-box">
    <div class="modal-head">
      <div>
        <h3><i class="bi bi-patch-question-fill" style="color:var(--p);margin-right:.35rem"></i>Ask a Doubt</h3>
        <p>Be specific — the more detail you give, the better the answers.</p>
      </div>
      <button class="modal-close" onclick="closeModal('askModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <div class="form-mb">
        <label class="form-lbl">Doubt Title <span class="req">*</span></label>
        <input class="finput" type="text" placeholder="E.g. How do I find the derivative of sin(x)?"/>
        <div class="form-hint">Be specific. Imagine you're asking your teacher face-to-face.</div>
      </div>
      <div class="form-mb">
        <label class="form-lbl">Detailed Description <span class="req">*</span></label>
        <textarea class="finput" rows="4" placeholder="Explain where exactly you're stuck, what you've tried, and any relevant formulas or context…"></textarea>
      </div>
      <div class="form-row form-mb">
        <div>
          <label class="form-lbl">Subject <span class="req">*</span></label>
          <select class="finput fselect">
            <option value="">Select subject…</option>
            <option>Mathematics</option>
            <option>Physics</option>
            <option>Chemistry</option>
            <option>Biology</option>
            <option>Computer Science</option>
            <option>English</option>
            <option>Social Science</option>
            <option>Malayalam</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label class="form-lbl">Class / Grade</label>
          <select class="finput fselect">
            <option value="">Select class…</option>
            <option>Class 6</option><option>Class 7</option><option>Class 8</option>
            <option>Class 9</option><option>Class 10</option><option>Class 11</option>
            <option>Class 12</option>
          </select>
        </div>
      </div>
      <div class="form-mb">
        <label class="form-lbl">Tags</label>
        <input class="finput" type="text" placeholder="algebra, equations, quadratic (comma-separated)"/>
        <div class="form-hint">Helps others find your doubt faster.</div>
      </div>
      <div class="form-mb">
        <label class="form-lbl">Attach Image (Optional)</label>
        <div class="upload-area">
          <i class="bi bi-cloud-upload"></i>
          <p>Drag & drop or click to upload</p>
          <small>PNG, JPG up to 5MB — great for equations or diagrams</small>
        </div>
      </div>
      <div class="xp-hint-box">
        <i class="bi bi-star-fill" style="color:var(--amber);margin-right:.25rem"></i>
        Posting this doubt earns you <strong>+5 XP</strong>!
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('askModal')">Cancel</button>
      <button class="ask-btn" onclick="submitDoubt()">
        <i class="bi bi-send-fill"></i> Post Doubt
      </button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     ANSWERS MODAL
══════════════════════════════════════════ -->

{{> ask-doubt}}

<!-- XP Toast -->
<div class="xp-toast" id="xpToast">
  <span>⭐</span><span id="xpToastMsg">+5 XP earned!</span>
</div>
{{#if xpReward}}
<script>
Swal.fire({
    title: "🎉 Congratulations!",
    text: "You earned +{{xpReward.amount}} XP!",
    icon: "success",
    timer: 2000,
    showConfirmButton: false
});
</script>
{{/if}}
{{#if upvoteReward}}
<script>
Swal.fire({
  title: "👍 Upvote Received!",
  text: "Your doubt received upvotes! +{{upvoteReward}} XP",
  icon: "success",
  timer: 2500,
  showConfirmButton: false
});
</script>
{{/if}}
